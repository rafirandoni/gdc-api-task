      "updated": 1788430691178,
      "link": null,
      "locked": false,
      "text": "-- Tasks schema. Schema management (bun/migrate) was intentionally left out of\n-- the boilerplate; apply this DDL to create the table, e.g.:\n--   psql \"$DATABASE_URL\" -f db/schema.sql\nCREATE TABLE\n    IF NOT EXISTS users (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        email VARCHAR(150) NOT NULL,\n        password VARCHAR(200) NOT NULL\n    );\n\nCREATE UNIQUE INDEX idx_users_email ON users (email);\n\nCREATE TABLE\n    IF NOT EXISTS role (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        label VARCHAR(150) NOT NULL,\n        status VARCHAR(16) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'INACTIVE', 'BANNED'))\n    );\n\nCREATE TABLE\n    IF NOT EXISTS user_role (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        user_id INT NOT NULL REFERENCES users (id),\n        role_id INT NOT NULL REFERENCES role (id),\n        status VARCHAR(16) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'INACTIVE'))\n    );\n\nCREATE UNIQUE INDEX idx_user_role_user_role ON user_role (user_id, role_id);\n\nCREATE TABLE\n    IF NOT EXISTS tasks (\n        id UUID NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        user_id BIGINT,\n        idempotency_key VARCHAR(150) NOT NULL,\n        title VARCHAR(255) NOT NULL,\n        description TEXT,\n        status VARCHAR(16) NOT NULL DEFAULT 'BACKLOG' CHECK (\n            status IN (\n                'BACKLOG',\n                'ON_PROGRESS',\n                'ON_REVIEW',\n                'FEEDBACK',\n                'FINISHED'\n            )\n        )\n    );\n\nCREATE INDEX idx_tasks_idempotency ON tasks (idempotency_key);\n\nCREATE INDEX idx_tasks_status ON tasks (status);\n\nCREATE TABLE\n    IF NOT EXISTS task_logs (\n        id UUID NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        task_id UUID NOT NULL,\n        title VARCHAR(255) NOT NULL,\n        description TEXT,\n        status VARCHAR(16) NOT NULL DEFAULT 'BACKLOG' CHECK (\n            status IN (\n                'BACKLOG',\n                'ON_PROGRESS',\n                'ON_REVIEW',\n                'FEEDBACK',\n                'FINISHED'\n            )\n        )\n    );\n\nCREATE INDEX idx_task_logs_task_id ON task_logs (task_id);",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Tasks schema. Schema management (bun/migrate) was intentionally left out of\n-- the boilerplate; apply this DDL to create the table, e.g.:\n--   psql \"$DATABASE_URL\" -f db/schema.sql\nCREATE TABLE\n    IF NOT EXISTS users (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        email VARCHAR(150) NOT NULL,\n        password VARCHAR(200) NOT NULL\n    );\n\nCREATE UNIQUE INDEX idx_users_email ON users (email);\n\nCREATE TABLE\n    IF NOT EXISTS role (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        label VARCHAR(150) NOT NULL,\n        status VARCHAR(16) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'INACTIVE', 'BANNED'))\n    );\n\nCREATE TABLE\n    IF NOT EXISTS user_role (\n        id SERIAL NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        user_id INT NOT NULL REFERENCES users (id),\n        role_id INT NOT NULL REFERENCES role (id),\n        status VARCHAR(16) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'INACTIVE'))\n    );\n\nCREATE UNIQUE INDEX idx_user_role_user_role ON user_role (user_id, role_id);\n\nCREATE TABLE\n    IF NOT EXISTS tasks (\n        id UUID NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        deleted_at TIMESTAMP,\n        user_id BIGINT,\n        idempotency_key VARCHAR(150) NOT NULL,\n        title VARCHAR(255) NOT NULL,\n        description TEXT,\n        status VARCHAR(16) NOT NULL DEFAULT 'BACKLOG' CHECK (\n            status IN (\n                'BACKLOG',\n                'ON_PROGRESS',\n                'ON_REVIEW',\n                'FEEDBACK',\n                'FINISHED'\n            )\n        )\n    );\n\nCREATE INDEX idx_tasks_idempotency ON tasks (idempotency_key);\n\nCREATE INDEX idx_tasks_status ON tasks (status);\n\nCREATE TABLE\n    IF NOT EXISTS task_logs (\n        id UUID NOT NULL PRIMARY KEY,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        updated_at TIMESTAMP,\n        task_id UUID NOT NULL,\n        title VARCHAR(255) NOT NULL,\n        description TEXT,\n        status VARCHAR(16) NOT NULL DEFAULT 'BACKLOG' CHECK (\n            status IN (\n                'BACKLOG',\n                'ON_PROGRESS',\n                'ON_REVIEW',\n                'FEEDBACK',\n                'FINISHED'\n            )\n        )\n    );\n\nCREATE INDEX idx_task_logs_task_id ON task_logs (task_id);",
      "autoResize": true,
      "lineHeight": 1.35
    },
